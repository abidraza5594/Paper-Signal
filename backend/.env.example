APP_ENV=local
DATA_DIR=data
MAX_UPLOAD_MB=200
MAX_PDF_PAGES=50
MAX_BATCH_FILES=10
MAX_BATCH_TOTAL_MB=500
MAX_PENDING_JOBS=100
LOCAL_WORKER_COUNT=10
CORS_ORIGINS=http://localhost:4200

# Required for semantic extraction and scanned-page OCR.
# Comma-separated in primary-to-fallback order. MISTRAL_API_KEY remains supported.
MISTRAL_API_KEYS=
AI_PROVIDER=mistral
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash
GEMINI_VERIFICATION_MODEL=gemini-3.5-flash
GEMINI_MIN_REQUEST_INTERVAL_SECONDS=15
MISTRAL_TEXT_MODEL=mistral-small-2603
MISTRAL_VERIFICATION_MODEL=mistral-large-2512
AI_REQUEST_TIMEOUT_SECONDS=120
MISTRAL_OCR_MODEL=mistral-ocr-4-0

# Processing controls
OCR_MIN_TEXT_CHARS=80
VISION_MIN_TEXT_CHARS=40
VISION_RENDER_DPI=144
TEXT_CHUNK_CHARS=50000
OCR_PAGE_BATCH_SIZE=40
MERGE_BATCH_SIZE=8
# Evidence pipeline: local context limit, per-document candidate budget, opt-in raw debug output.
EXTRACTION_WINDOW_CHARS=16000
EXTRACTION_MAX_CANDIDATES=5000
EXTRACTION_DEBUG=false

# --- API service mode ---
# false: local development, the Angular console works without a key.
# true:  every /api call needs X-API-Key (or Authorization: Bearer). Turn this on
#        before exposing the service to anyone else.
REQUIRE_API_KEY=false

# Needed only to manage keys over HTTP (/api/admin/keys). The manage_keys.py CLI
# works without it. Use a long random value.
ADMIN_TOKEN=

# Defaults applied to a new key when the caller does not specify them.
DEFAULT_RATE_LIMIT_PER_MINUTE=60
DEFAULT_MONTHLY_DOCUMENT_QUOTA=1000

# Retry behaviour for rate-limited or transient upstream AI failures.
AI_MAX_RETRIES=3
AI_RETRY_BASE_SECONDS=1.0
